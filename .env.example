# 默认使用 Instant Mail 分配 gmail.com 邮箱，无需邮箱账号密码。
MAIL_PROVIDER=instant_mail
# 可选兼容 Cloud Mail：改为 MAIL_PROVIDER=cloud_mail，并填写以下三项。
CLOUD_MAIL_URL=
CLOUD_MAIL_EMAIL=
# 含 # 等字符时使用引号。
CLOUD_MAIL_PASSWORD=
# 首次运行先 docker compose build，使用包含 Gmail 改造的本地镜像。
NODES_IMAGE=nodes:local
# 自动查找 Chrome/Chromium；Docker 默认 /usr/bin/chromium。
BROWSER_PATH=
# 留空使用安装包内的 nodes/resources/turnstile/。
TURNSTILE_EXTENSION_PATH=
# 可选：同时填写 Resin 站点地址和管理令牌，导出后自动合并到一个专用本地订阅。
# 地址不包含 /api/v1；使用管理令牌，不是代理令牌。留空则不连接 Resin。
RESIN_URL=
RESIN_ADMIN_TOKEN=
RESIN_SUBSCRIPTION_NAME=nodes
# 账号加密备份密钥：通过进程环境变量 NODES_ACCOUNT_BACKUP_KEY 提供。
# 不写入此文件；本机 CLI 不从 .env 读取该密钥。GitHub 使用同名 Repository Secret。
# --login 的密码从隐藏交互提示或进程环境变量 NODES_ACCOUNT_PASSWORD 读取。
